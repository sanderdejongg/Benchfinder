# editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 4

[{Makefile,Dockerfile,Caddyfile,*.sh}]
indent_style = tab

[{compose.yaml,.github/**/*.{yaml,yml}}]
indent_size = 2

[*.md]
indent_size = unset
indent_style = unset

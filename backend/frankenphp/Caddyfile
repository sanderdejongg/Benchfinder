{
	skip_install_trust

	frankenphp
}

# No `log` directive: Caddy writes no access log. This keeps the visitor ID
# and request coordinates out of logs (3-visitor-identity D13). Adding a `log`
# directive requires filtering request>headers>X-Visitor-Id first.
{$SERVER_NAME:localhost} {
	root /app/public
	encode zstd br gzip

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}

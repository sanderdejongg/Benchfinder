<?xml version="1.0"?>
<ruleset name="Benchfinder" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>Non-formatting Slevomat sniffs only. Formatting belongs to PHP-CS-Fixer (6-architecture-setup D25).</description>

    <config name="installed_paths" value="vendor/slevomat/coding-standard"/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>bin</file>
    <file>config</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>

    <!-- Generated by Symfony on cache:clear; excluded from PHP-CS-Fixer by the recipe too. -->
    <exclude-pattern>config/reference.php</exclude-pattern>
    <exclude-pattern>config/bundles.php</exclude-pattern>

    <!-- Types -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.DisallowMixedTypeHint"/>
    <!-- Complexity -->
    <rule ref="SlevomatCodingStandard.Complexity.Cognitive"/>
    <!-- Classes -->
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>
    <rule ref="SlevomatCodingStandard.Classes.ForbiddenPublicProperty"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireAbstractOrFinal"/>
    <!-- Functions -->
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>
    <rule ref="SlevomatCodingStandard.Functions.UnusedParameter"/>
    <rule ref="SlevomatCodingStandard.Functions.DisallowEmptyFunction"/>
    <!-- Variables -->
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
    <rule ref="SlevomatCodingStandard.Variables.UselessVariable"/>
    <!-- Exceptions -->
    <rule ref="SlevomatCodingStandard.Exceptions.DeadCatch"/>
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>
    <!-- Operators -->
    <rule ref="SlevomatCodingStandard.Operators.DisallowEqualOperators"/>
</ruleset>

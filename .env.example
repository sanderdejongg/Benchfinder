POSTGRES_USER=benchfinder
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=benchfinder

# Matches the postgres service above. No pooler in front locally, so
# LISTEN/NOTIFY (realtime-push design) works without the pgBouncer
# transaction-mode caveat that applies to some managed providers in prod.
DATABASE_URL=postgres://benchfinder:devpassword@localhost:5432/benchfinder?sslmode=disable
